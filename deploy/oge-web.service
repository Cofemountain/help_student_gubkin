[Unit]
Description=OGE Physics Mini App Backend (FastAPI + SPA)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/oge_physics
Environment="PATH=/var/www/oge_physics/venv/bin"
ExecStart=/var/www/oge_physics/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
