# База данных:
# Для локальной разработки и легкого продакшена на SQLite (async):
DATABASE_URL=sqlite+aiosqlite:///./oge_physics.db

# Для production на PostgreSQL (Docker или внешний сервер):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/oge_physics_db

# Токен бота платформы МАКС (платформа platform-api2.max.ru):
MAX_BOT_TOKEN=your_max_bot_token_here

# Токен Telegram-бота (опционально, если используется Telegram-версия):
BOT_TOKEN=your_telegram_bot_token_here

# Режим отладки (True для разработки, False для боевого сервера):
DEBUG=False
